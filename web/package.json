{
  "name": "qlu-exam-papers",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron:renderer": "vite build --mode electron",
    "build:electron:main": "tsc -p electron/tsconfig.json",
    "build:electron": "npm run build:electron:renderer && npm run build:electron:main",
    "preview": "vite preview",
    "electron:start": "npm run build:electron && electron dist-electron/main.js",
    "electron:package": "npm run build:electron && electron-builder"
  },
  "dependencies": {
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "fuse.js": "^7.0.0",
    "pdfjs-dist": "^4.0.379",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@vitejs/plugin-vue": "^5.1.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.5.4",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
